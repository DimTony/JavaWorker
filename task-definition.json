{
  "family": "fourteen-worker-task",
  "executionRoleArn": "arn:aws:iam::012834916544:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "fourteen-worker-container",
      "image": "012834916544.dkr.ecr.eu-north-1.amazonaws.com/fourteen-worker:latest",
      "cpu": 0,
      "essential": true,
      "environment": [
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        { "name": "REDIS_QUEUE", "value": "scan-jobs" },
        { "name": "WORKER_THREADS", "value": "4" },
        { "name": "WORKER_BLPOP_TIMEOUT", "value": "5" }
      ],
      "secrets": [
        {
          "name": "DB_URL",
          "valueFrom": "arn:aws:ssm:eu-north-1:012834916544:parameter/fourteen/production/ConnectionStrings__DbUrl"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:ssm:eu-north-1:012834916544:parameter/fourteen/production/Db_User"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:eu-north-1:012834916544:parameter/fourteen/production/Db_Pass"
        },
        {
          "name": "REDIS_HOST",
          "valueFrom": "arn:aws:ssm:eu-north-1:012834916544:parameter/fourteen/production/ConnectionStrings__JavaRedis"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:ssm:eu-north-1:012834916544:parameter/fourteen/production/ANTHROPIC__KEY"
        },
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:ssm:eu-north-1:012834916544:parameter/fourteen/production/GROQ_API_KEY"
        },
        {
          "name": "GROK_API_KEY",
          "valueFrom": "arn:aws:ssm:eu-north-1:012834916544:parameter/fourteen/production/GROK_API_KEY"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:ssm:eu-north-1:012834916544:parameter/fourteen/production/GEMINI_API_KEY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fourteen-worker",
          "awslogs-create-group": "true",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
